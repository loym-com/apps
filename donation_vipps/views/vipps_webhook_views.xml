<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_donation_vipps_webhook_tree" model="ir.ui.view">
        <field name="name">donation.vipps.webhook.tree</field>
        <field name="model">donation.vipps.webhook</field>
        <field name="arch" type="xml">
            <tree>
                <field name="received_at" />
                <field name="method" />
                <field name="remote_addr" />
                <field name="processed" />
            </tree>
        </field>
    </record>

    <record id="view_donation_vipps_webhook_form" model="ir.ui.view">
        <field name="name">donation.vipps.webhook.form</field>
        <field name="model">donation.vipps.webhook</field>
        <field name="arch" type="xml">
            <form string="Vipps Webhook">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="received_at" />
                            <field name="method" />
                            <field name="path" />
                            <field name="remote_addr" />
                            <field name="processed" />
                        </group>
                        <group>
                            <field name="processing_error" placeholder="Processing error" />
                        </group>
                    </group>
                    <group string="Headers" col="1">
                        <field name="headers" nolabel="1" placeholder="Pretty-printed request headers" />
                    </group>
                    <group string="Payload" col="1">
                        <field name="payload" nolabel="1" placeholder="Raw webhook payload" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_donation_vipps_webhook" model="ir.actions.act_window">
        <field name="name">Webhooks</field>
        <field name="res_model">donation.vipps.webhook</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_donation_vipps_webhook_tree" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_donation_vipps_webhook" />
        <field name="sequence" eval="1" />
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_donation_vipps_webhook_tree" />
    </record>

    <record id="action_donation_vipps_webhook_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="action_donation_vipps_webhook" />
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_donation_vipps_webhook_form" />
    </record>
</odoo>
