<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- x_role -->
    <record id="field_x_role__x_name" model="ir.model.fields">
        <field name="name">x_name</field>
        <field name="ttype">char</field>
        <field name="model_id" ref="model_x_role"/>
        <field name="field_description">Name</field>
    </record>
    <!-- knowledge.article -->
    <record id="field_knowledge_article__x_role_id" model="ir.model.fields">
        <field name="name">x_role_id</field>
        <field name="ttype">many2one</field>
        <field name="model_id" ref="knowledge.model_knowledge_article"/>
        <field name="field_description">Role</field>
        <field name="relation">x_role</field>
        <field name="help">Purpose - Categorize tasks by role</field>
        <field name="on_delete">restrict</field>
    </record>
    <record id="field_knowledge_article__x_deadline" model="ir.model.fields">
        <field name="name">x_deadline</field>
        <field name="ttype">date</field>
        <field name="model_id" ref="knowledge.model_knowledge_article"/>
        <field name="field_description">Deadline</field>
        <field name="help">Purpose - Sort by Deadline</field>
        <field name="copied">False</field>
    </record>
    <record id="field_knowledge_article__x_lastdone" model="ir.model.fields">
        <field name="name">x_lastdone</field>
        <field name="ttype">date</field>
        <field name="model_id" ref="knowledge.model_knowledge_article"/>
        <field name="field_description">Last Done</field>
        <field name="help">Purpose - Sort by Last Done</field>
        <field name="copied">False</field>
    </record>
    <record id="field_knowledge_article__x_frequency" model="ir.model.fields">
        <field name="name">x_frequency</field>
        <field name="ttype">selection</field>
        <field name="model_id" ref="knowledge.model_knowledge_article"/>
        <field name="field_description">Frequency</field>
        <field name="help">Purpose - Compute next deadline</field>
        <field name="copied">False</field>
        <field name="selection">[('weekly', 'Weekly'), ('monthly', 'Monthly'), ('yearly', 'Yearly')]</field>
    </record>
    <!-- account.analytic.line -->
    <record id="field_account_analytic_line__x_article_id" model="ir.model.fields">
        <field name="name">x_article_id</field>
        <field name="ttype">many2one</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="field_description">Task</field>
        <field name="help">Purpose - Log hours per task</field>
        <field name="relation">knowledge.article</field>
        <field name="on_delete">restrict</field>
    </record>
    <record id="field_account_analytic_line__x_role_id" model="ir.model.fields">
        <field name="name">x_role_id</field>
        <field name="ttype">many2one</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="field_description">Role</field>
        <field name="help">Purpose - See hours per role</field>
        <field name="relation">x_role</field>
        <field name="related">x_article_id.x_role_id</field><!-- AFTER knowledge.article-->
    </record>
</odoo>
