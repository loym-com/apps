<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pos_payment_terminal_log_view_tree" model="ir.ui.view">
        <field name="name">Payment terminal log list</field>
        <field name="model">pos.payment.terminal.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0">
                <field name="create_date" />
                <field name="create_uid" optional="hide" />
                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"
                />
                <field name="url" />
                <field name="direction" />
                <field name="host" optional="hide" />
                <field name="status" />
                <field name="client_id" />
                <field name="receipt_no" />
                <field name="receipt_total" />
                <field name="log" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="pos_payment_terminal_log_view_form" model="ir.ui.view">
        <field name="name">Payment terminal log form</field>
        <field name="model">pos.payment.terminal.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="create_date" />
                        <field name="create_uid" />
                        <field name="company_id" />
                        <field name="url" />
                        <field name="direction" />
                        <field name="host" />
                        <field name="status" />
                        <field name="client_id" />
                        <field name="receipt_no" />
                        <field name="receipt_total" />
                        <field name="log" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pos_payment_terminal_log_action" model="ir.actions.act_window">
        <field name="name">Payment Log</field>
        <field name="res_model">pos.payment.terminal.log</field>
        <field name="view_mode">tree,form</field>
        <field name="groups_id" eval="[(4, ref('point_of_sale.group_pos_manager'))]" />
    </record>
    <menuitem
        id="pos_payment_terminal_log_menuitem"
        name="Payment Terminal Log"
        sequence="100"
        parent="point_of_sale.menu_point_config_product"
        groups="base.group_no_one"
        action="pos_payment_terminal_log_action"
    />
</odoo>
