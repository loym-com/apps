<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_report_view_list" model="ir.ui.view">
        <field name="name">account.report.view.list</field>
        <field name="model">account.report</field>
        <field name="arch" type="xml">
            <list string="Accounting Reports">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="root_report_id"/>
                <field name="chart_template"/>
                <field name="country_id"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="account_report_view_form" model="ir.ui.view">
        <field name="name">account.report.view.form</field>
        <field name="model">account.report</field>
        <field name="arch" type="xml">
            <form string="Accounting Report">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="sequence"/>
                            <field name="root_report_id"/>
                            <field name="chart_template"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="filter_date_range"/>
                            <field name="default_opening_date_filter"/>
                            <field name="availability_condition"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Columns" name="columns">
                            <field name="column_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="expression_label"/>
                                    <field name="figure_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="foldable"/>
                                    <field name="groupby"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_report_action" model="ir.actions.act_window">
        <field name="name">Accounting Reports</field>
        <field name="res_model">account.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="account_report_menu"
        name="Accounting Reports"
        parent="account.account_account_menu"
        action="account_report_action"
        groups="account.group_account_readonly"
    />

</odoo>
