<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem
        id="account_report_menu_generic_reports"
        name="Generic Reports"
        parent="account.menu_finance_reports"
        sequence="55"
        groups="account.group_account_readonly"
    />
    <!-- PROFIT / LOSS REPORT -->
    <record id="account_report_profit_loss" model="account.report">
        <field name="name">Profit / Loss</field>
        <field name="filter_date_range" eval="True"/>
        <field name="column_ids">
            <record id="account_report_column_profit_loss_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="account_report_line_profit_loss_income" model="account.report.line">
                <field name="name">Income</field>
                <field name="code">profit_loss_income</field>
                <field name="expression_ids">
                    <record id="account_report_expression_profit_loss_income_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.internal_group', '=', 'income')]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="account_report_line_profit_loss_income_operating" model="account.report.line">
                        <field name="name">Income</field>
                        <field name="foldability">foldable</field>
                        <field name="groupby">account_id</field>
                        <field name="expression_ids">
                            <record id="account_report_expression_profit_loss_income_operating_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'income')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_line_profit_loss_income_other" model="account.report.line">
                        <field name="name">Other Income</field>
                        <field name="foldability">foldable</field>
                        <field name="groupby">account_id</field>
                        <field name="expression_ids">
                            <record id="account_report_expression_profit_loss_income_other_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'income_other')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="account_report_line_profit_loss_expense" model="account.report.line">
                <field name="name">Expenses</field>
                <field name="code">profit_loss_expense</field>
                <field name="expression_ids">
                    <record id="account_report_expression_profit_loss_expense_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.internal_group', '=', 'expense')]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="account_report_line_profit_loss_expense_operating" model="account.report.line">
                        <field name="name">Expenses</field>
                        <field name="foldability">foldable</field>
                        <field name="groupby">account_id</field>
                        <field name="expression_ids">
                            <record id="account_report_expression_profit_loss_expense_operating_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'expense')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_line_profit_loss_expense_other" model="account.report.line">
                        <field name="name">Other Expenses</field>
                        <field name="foldability">foldable</field>
                        <field name="groupby">account_id</field>
                        <field name="expression_ids">
                            <record id="account_report_expression_profit_loss_expense_other_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'expense_other')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_line_profit_loss_expense_depreciation" model="account.report.line">
                        <field name="name">Depreciation</field>
                        <field name="foldability">foldable</field>
                        <field name="groupby">account_id</field>
                        <field name="expression_ids">
                            <record id="account_report_expression_profit_loss_expense_depreciation_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'expense_depreciation')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_line_profit_loss_expense_direct_cost" model="account.report.line">
                        <field name="name">Cost of Revenue</field>
                        <field name="foldability">foldable</field>
                        <field name="groupby">account_id</field>
                        <field name="expression_ids">
                            <record id="account_report_expression_profit_loss_expense_direct_cost_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'expense_direct_cost')]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="account_report_line_profit_loss_total" model="account.report.line">
                <field name="name">Profit / Loss</field>
                <field name="code">profit_loss_total</field>
                <field name="expression_ids">
                    <record id="account_report_expression_profit_loss_total_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <!-- <field name="engine">aggregation</field>
                        <field name="formula">profit_loss_income.balance+profit_loss_expense.balance</field> -->
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.internal_group', 'in', ['income', 'expense'])]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="account_report_line_profit_loss_total_detail" model="account.report.line">
                        <field name="name">Profit / Loss</field>
                        <field name="code">profit_loss_total_detail</field>
                        <field name="expression_ids">
                            <record id="account_report_expression_profit_loss_total_detail_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <!-- <field name="engine">aggregation</field>
                                <field name="formula">profit_loss_income.balance+profit_loss_expense.balance</field> -->
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.internal_group', 'in', ['income', 'expense'])]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>
    <record id="action_profit_loss_report" model="ir.actions.client">
        <field name="name">Profit / Loss</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('account_report_generic.account_report_profit_loss')}"/>
    </record>
    <menuitem
        id="account_report_menu_profit_loss"
        name="Profit / Loss"
        parent="account_report_menu_generic_reports"
        action="action_profit_loss_report"
        sequence="55"
        groups="account.group_account_readonly"
    />
    <!-- BALANCE SHEET REPORT -->
    <record id="account_report_balance_sheet" model="account.report">
        <field name="name">Balance Sheet</field>
        <field name="filter_date_range" eval="True"/>
        <field name="column_ids">
            <record id="account_report_column_balance_sheet_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="account_report_line_balance_sheet_asset" model="account.report.line">
                <field name="name">Assets</field>
                <field name="code">balance_sheet_asset</field>
                <field name="expression_ids">
                    <record id="account_report_expression_balance_sheet_asset_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.internal_group', '=', 'asset')]"/>
                        <field name="subformula">sum</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="account_report_line_balance_sheet_asset_receivable" model="account.report.line">
                        <field name="name">Receivable</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_asset_receivable_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'asset_receivable')]"/><field name="subformula">sum</field></record></field>
                    </record>
                    <record id="account_report_line_balance_sheet_asset_cash" model="account.report.line">
                        <field name="name">Bank and Cash</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_asset_cash_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'asset_cash')]"/><field name="subformula">sum</field></record></field>
                    </record>
                    <record id="account_report_line_balance_sheet_asset_current" model="account.report.line">
                        <field name="name">Current Assets</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_asset_current_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'asset_current')]"/><field name="subformula">sum</field></record></field>
                    </record>
                    <record id="account_report_line_balance_sheet_asset_non_current" model="account.report.line">
                        <field name="name">Non-current Assets</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_asset_non_current_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'asset_non_current')]"/><field name="subformula">sum</field></record></field>
                    </record>
                    <record id="account_report_line_balance_sheet_asset_prepayments" model="account.report.line">
                        <field name="name">Prepayments</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_asset_prepayments_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'asset_prepayments')]"/><field name="subformula">sum</field></record></field>
                    </record>
                    <record id="account_report_line_balance_sheet_asset_fixed" model="account.report.line">
                        <field name="name">Fixed Assets</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_asset_fixed_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'asset_fixed')]"/><field name="subformula">sum</field></record></field>
                    </record>
                </field>
            </record>
            <record id="account_report_line_balance_sheet_equity" model="account.report.line">
                <field name="name">Equity</field>
                <field name="code">balance_sheet_equity</field>
                <field name="expression_ids"><record id="account_report_expression_balance_sheet_equity_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.internal_group', '=', 'equity')]"/><field name="subformula">sum</field></record></field>
                <field name="children_ids">
                    <record id="account_report_line_balance_sheet_equity_regular" model="account.report.line">
                        <field name="name">Equity</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_equity_regular_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'equity')]"/><field name="subformula">sum</field></record></field>
                    </record>
                    <record id="account_report_line_balance_sheet_equity_unaffected" model="account.report.line">
                        <field name="name">Current Year Earnings</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_equity_unaffected_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'equity_unaffected')]"/><field name="subformula">sum</field></record></field>
                    </record>
                </field>
            </record>
            <record id="account_report_line_balance_sheet_liability" model="account.report.line">
                <field name="name">Liabilities</field>
                <field name="code">balance_sheet_liability</field>
                <field name="expression_ids"><record id="account_report_expression_balance_sheet_liability_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.internal_group', '=', 'liability')]"/><field name="subformula">sum</field></record></field>
                <field name="children_ids">
                    <record id="account_report_line_balance_sheet_liability_payable" model="account.report.line">
                        <field name="name">Payable</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_liability_payable_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'liability_payable')]"/><field name="subformula">sum</field></record></field>
                    </record>
                    <record id="account_report_line_balance_sheet_liability_credit_card" model="account.report.line">
                        <field name="name">Credit Card</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_liability_credit_card_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'liability_credit_card')]"/><field name="subformula">sum</field></record></field>
                    </record>
                    <record id="account_report_line_balance_sheet_liability_current" model="account.report.line">
                        <field name="name">Current Liabilities</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_liability_current_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'liability_current')]"/><field name="subformula">sum</field></record></field>
                    </record>
                    <record id="account_report_line_balance_sheet_liability_non_current" model="account.report.line">
                        <field name="name">Non-current Liabilities</field><field name="foldability">foldable</field><field name="groupby">account_id</field>
                        <field name="expression_ids"><record id="account_report_expression_balance_sheet_liability_non_current_balance" model="account.report.expression"><field name="label">balance</field><field name="engine">domain</field><field name="formula" eval="[('account_id.account_type', '=', 'liability_non_current')]"/><field name="subformula">sum</field></record></field>
                    </record>
                </field>
            </record>
            <record id="account_report_line_balance_sheet_equity_liability" model="account.report.line">
                <field name="name">Equity &amp; Liability</field>
                <field name="code">balance_sheet_equity_liability</field>
                <field name="expression_ids">
                    <record id="account_report_expression_balance_sheet_equity_liability_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <!-- <field name="engine">aggregation</field>
                        <field name="formula">balance_sheet_equity.balance+balance_sheet_liability.balance</field> -->
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.internal_group', 'in', ['equity', 'liability'])]"/>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="account_report_line_balance_sheet_equity_liability_detail" model="account.report.line">
                        <field name="name">Equity &amp; Liability</field>
                        <field name="code">balance_sheet_equity_liability_detail</field>
                        <field name="expression_ids">
                            <record id="account_report_expression_balance_sheet_equity_liability_detail_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <!-- <field name="engine">aggregation</field>
                                <field name="formula">balance_sheet_equity.balance+balance_sheet_liability.balance</field> -->
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.internal_group', 'in', ['equity', 'liability'])]"/>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>
    <record id="action_balance_sheet_report" model="ir.actions.client">
        <field name="name">Balance Sheet</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('account_report_generic.account_report_balance_sheet')}"/>
    </record>
    <menuitem
        id="account_report_menu_balance_sheet"
        name="Balance Sheet"
        parent="account_report_menu_generic_reports"
        action="action_balance_sheet_report"
        sequence="55"
        groups="account.group_account_readonly"
    />
    <!-- TRIAL BALANCE REPORT -->
    <record id="account_report_trial_balance" model="account.report">
        <field name="name">Trial Balance</field>
        <field name="filter_date_range" eval="True"/>
        <field name="column_ids">
            <record id="account_report_column_trial_balance_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="account_report_line_trial_balance" model="account.report.line">
                <field name="name">Trial Balance</field>
                <field name="code">trial_balance</field>
                <field name="foldability">always_unfolded</field>
                <field name="user_groupby">account_id</field>
                <field name="expression_ids">
                    <record id="account_report_expression_trial_balance_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id', '!=', False)]"/>
                        <field name="subformula">sum</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
    <record id="action_trial_balance_report" model="ir.actions.client">
        <field name="name">Trial Balance</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('account_report_generic.account_report_trial_balance')}"/>
    </record>
    <menuitem
        id="account_report_menu_trial_balance"
        name="Trial Balance"
        parent="account_report_menu_generic_reports"
        action="action_trial_balance_report"
        sequence="55"
        groups="account.group_account_readonly"
    />
</odoo>
