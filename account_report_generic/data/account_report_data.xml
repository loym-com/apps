<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_balance_report" model="account.report">
        <field name="name">Account Balance</field>
        <field name="filter_date_range" eval="True"/>
        <field name="column_ids">
            <record id="account_balance_report_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>

        <field name="line_ids">
            <!-- En rad per konto -->
            <record id="account_balance_report_by_account" model="account.report.line">
                <field name="name">Account Balance</field>
                <!-- <field name="groupby">account_id</field> -->
                <field name="expression_ids">
                    <record id="account_balance_report_by_account_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id', '!=', False)]"/>
                        <field name="subformula">sum</field>
                    </record>
                </field>
            </record>

            <!-- Totalrad -->
            <record id="account_balance_report_total" model="account.report.line">
                <field name="name">Total</field>
                <field name="expression_ids">
                    <record id="account_balance_report_total_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id', '!=', False)]"/>
                        <field name="subformula">sum</field>
                    </record>
                </field>
            </record>
        </field>
    </record>

    <record id="action_account_balance_report" model="ir.actions.client">
        <field name="name">Account Balance</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'report_id': ref('account_report_generic.account_balance_report')}"/>
    </record>

    <menuitem id="menu_account_balance_report"
              name="Account Balance"
              parent="account.menu_finance_reports"
              action="action_account_balance_report"
              sequence="55"
              groups="account.group_account_readonly"/>
</odoo>
