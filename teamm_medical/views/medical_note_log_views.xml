<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="medical_note_log_view_form" model="ir.ui.view">
        <field name="name">medical.note.log.view.form</field>
        <field name="model">medical.note.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="medical_note_id" />
                        <field name="create_date" />
                        <field name="create_uid" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="medical_note_log_view_tree" model="ir.ui.view">
        <field name="name">medical.note.log.view.tree</field>
        <field name="model">medical.note.log</field>
        <field name="arch" type="xml">
            <tree>
                        <field name="medical_note_id" optional="show" />
                        <field name="create_date" optional="show" />
                        <field name="create_uid" optional="show" />
            </tree>
        </field>
    </record>
    <record id="medical_note_log_view_kanban" model="ir.ui.view">
        <field name="name">medical.note.log.view.kanban</field>
        <field name="model">medical.note.log</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <field name="display_name" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="medical_note_log_view_pivot" model="ir.ui.view">
        <field name="name">medical.note.log.view.pivot</field>
        <field name="model">medical.note.log</field>
        <field name="arch" type="xml">
            <pivot>
            </pivot>
        </field>
    </record>
    <record id="medical_note_log_view_search" model="ir.ui.view">
        <field name="name">medical.note.log.view.search</field>
        <field name="model">medical.note.log</field>
        <field name="arch" type="xml">
            <search>
                        <field name="medical_note_id" />
                        <field name="create_date" />
                        <field name="create_uid" />
                <group string="Group By">
                    <filter
                        string="Medical Note Id"
                        name="medical_note_id"
                        context="{'group_by':'medical_note_id'}"
                    />
                    <filter
                        string="Create Date"
                        name="create_date"
                        context="{'group_by':'create_date'}"
                    />
                    <filter
                        string="Create Uid"
                        name="create_uid"
                        context="{'group_by':'create_uid'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="medical_note_log_action" model="ir.actions.act_window">
        <field name="name">Medical Note Log</field>
        <field name="res_model">medical.note.log</field>
        <field name="view_mode">tree,kanban,pivot,form</field>
    </record>
</odoo>
