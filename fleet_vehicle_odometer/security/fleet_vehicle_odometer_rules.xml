<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rule for base.group_user to see only their own records -->
        <record id="self_service_rule_user" model="ir.rule">
            <field name="name">Self Service: Own Records</field>
            <field name="model_id" ref="model_fleet_vehicle_odometer"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Rule for fleet.fleet_group_user to see all records -->
        <record id="self_service_rule_salesman" model="ir.rule">
            <field name="name">Self Service: All Records</field>
            <field name="model_id" ref="model_fleet_vehicle_odometer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        </record>
    </data>
</odoo>
