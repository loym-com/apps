<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="fleet_vehicle_rule" model="ir.rule">
            <field name="name">fleet_vehicle_odometer: See all vehicles</field>
            <field name="model_id" ref="model_fleet_vehicle"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        </record>
        <record id="fleet_vehicle_odometer_rule_user" model="ir.rule">
            <field name="name">fleet_vehicle_odometer: See all logs</field>
            <field name="model_id" ref="model_fleet_vehicle_odometer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <!-- Record rules cause errors when computing odometer values. -->
            <!-- <field name="domain_force">['|', ('user_id', '=', user.id), ('analytic_user_ids', 'in', [user.id])]</field> -->
            <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        </record>
    </data>
</odoo>
