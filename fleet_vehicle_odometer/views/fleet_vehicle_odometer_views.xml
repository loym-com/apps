<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fleet_vehicle_odometer_view_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.odometer.tree</field>
        <field name="model">fleet.vehicle.odometer</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_odometer_view_tree" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="editable">bottom</attribute>
            </tree>
            <field name="vehicle_id" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="driver_id" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="value" position="attributes">
                <attribute name="widget">integer</attribute>
            </field>
            <tree position="inside">
                <field
                    name="analytic_plan_id"
                    options="{'no_create': True, 'no_create_edit':True}"
                    attrs="{'readonly': [('analytic_account_id', '!=', False)]}"
                />
                <field name="analytic_account_id" options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="destination" optional="show"/>
                <field name="comment" optional="show"/>
                <field name="distance" sum="Total Distance"/>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="account_analytic_account_kanban_view_ref" model="ir.ui.view">
        <field name="name">account_analytic_account_kanban_view_ref</field>
        <field name="model">account.analytic.account</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div>
                            <field name="display_name"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="fleet.fleet_vehicle_odometer_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.odometer.form</field>
        <field name="model">fleet.vehicle.odometer</field>
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_id" required="1" />
                            <label for="analytic_account_ids"/>
                            <div name="project" class="d-inline-flex w-100">
                                <button
                                    name="analytic.action_account_analytic_account_form"
                                    type="action"
                                    icon="fa-list"
                                    title="Analytic Accounts"
                                />
                                <field
                                    name="analytic_account_ids"
                                    options="{'no_create': True, 'no_create_edit':True}"
                                    widget="many2many_tags"
                                    context="{'kanban_view_ref': 'fleet_vehicle_odometer.account_analytic_account_kanban_view_ref'}"
                                />
                            </div>
                            <field name="destination" />
                            <field name="comment" />
                            <field name="value" widget="integer" string="Odometer Stop" />
                            <field name="value_start" />
                            <field name="distance" />
                            <field name="driver_id" domain="[('is_driver', '=', True)]" />
                            <field name="date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fleet_vehicle_odometer_view_pivot" model="ir.ui.view">
        <field name="name">fleet.vehicle.odometer.pivot</field>
        <field name="model">fleet.vehicle.odometer</field>
        <field name="mode">primary</field>
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <pivot>

            </pivot>
        </field>
    </record>
    <!-- view_mode: added 'pivot' -->
    <record id='fleet.fleet_vehicle_odometer_action' model='ir.actions.act_window'>
        <field name="name">Vehicles Odometer</field>
        <field name="res_model">fleet.vehicle.odometer</field>
        <field name="view_mode">tree,kanban,form,graph,pivot</field>
        <field name="context">{"search_default_groupby_vehicle" : True}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            Create a new odometer log
            </p>
            <p>
            You can add various odometer entries for all vehicles.
            </p>
        </field>
    </record>
</odoo>
