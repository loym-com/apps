<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fleet_vehicle_odometer_view_tree_mobile" model="ir.ui.view">
        <field name="name">fleet.vehicle.odometer.view.tree.mobile</field>
        <field name="model">fleet.vehicle.odometer</field>
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <tree>
                <field name="vehicle_id" />
                <field name="date" />
                <field name="analytic_distance" />
                <field name="analytic_cost" />
                <field name="analytic_user_ids" widget="many2many_tags" optional="hide" />
                <field name="user_id" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="fleet_vehicle_odometer_view_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.odometer.tree</field>
        <field name="model">fleet.vehicle.odometer</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_odometer_view_tree" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="editable">bottom</attribute>
            </tree>
            <field name="vehicle_id" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="driver_id" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="value" position="attributes">
                <attribute name="widget">integer</attribute>
            </field>
            <tree position="inside">
                <field
                    name="analytic_plan_id"
                    options="{'no_create': True, 'no_create_edit':True}"
                    attrs="{'readonly': [('analytic_account_id', '!=', False)]}"
                />
                <field name="analytic_account_id" options="{'no_create': True, 'no_create_edit':True}"/>
                <field name="destination" optional="show"/>
                <field name="comment" optional="show"/>
                <field name="distance" sum="Total Distance"/>
                <field name="name"/>
            </tree>
        </field>
    </record>
    <record id="fleet_vehicle_odometer_view_form_mobile" model="ir.ui.view">
        <field name="name">fleet.vehicle.odometer.view.form.mobile</field>
        <field name="model">fleet.vehicle.odometer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <group attrs="{'invisible': [('vehicle_id', '=', False)]}">
                                <h1 colspan="2">
                                    <field name="vehicle_id" attrs="{'invisible': [('vehicle_id', '=', False)]}"/>
                                </h1>
                                <field name="value_start" />
                                <field name="value" widget="integer" string="Odometer Stop" />
                                <field name="distance" />
                                <field name="analytic_plan_id" widget="many2one_buttons" />
                                <!-- <field name="analytic_account_id" widget="many2one_buttons" domain="[('plan_id', '=', analytic_plan_id)]"/> -->
                                <field name="analytic_account_ids" widget="many2many_buttons" domain="[('plan_id', '=', analytic_plan_id)]"/>
                                <field name="analytic_distance" />
                                <field name="product_variant_price" />
                                <field name="analytic_cost" />
                                <field name="destination" />
                                <field name="comment" />
                                <field name="user_id" />
                                <field name="date" />
                            </group>
                            <!-- vehicle_id cannot appear after selection_badge. Therefore this is in the end. -->
                            <field name="vehicle_id" widget="many2one_buttons" attrs="{'invisible': [('vehicle_id', '!=', False)]}" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="fleet_vehicle_odometer_view_graph_mobile" model="ir.ui.view">
        <field name="name">fleet.vehicle.odometer.view.graph.mobile</field>
        <field name="model">fleet.vehicle.odometer</field>
        <field name="arch" type="xml">
            <graph>
                <field name="date"/>
                <field name="analytic_cost" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="fleet_vehicle_odometer_view_pivot_mobile" model="ir.ui.view">
        <field name="name">fleet.vehicle.odometer.view.pivot.mobile</field>
        <field name="model">fleet.vehicle.odometer</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="date" type="col"/>
                <field name="analytic_distance" type="measure"/>
                <field name="analytic_cost" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="fleet_vehicle_odometer_view_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.odometer.view.search</field>
        <field name="model">fleet.vehicle.odometer</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_odometer_view_search" />
        <field name="arch" type="xml">
            <search position="inside">
                <filter
                    name="last_3_months"
                    string="Last 3 Months"
                    domain="[('date', '>=', (datetime.date(context_today().year, context_today().month, 1) - relativedelta(months=2)).strftime('%Y-%m-%d'))]"
                />
                <separator/>
                <filter
                    name="filter_analytic_user_ids"
                    string="My Records"
                    domain="[('analytic_user_ids', 'in', [uid])]"
                    help="Show only records assigned to me"
                />
            </search>
        </field>
    </record>
    <record id='fleet_vehicle_odometer_action_mobile' model='ir.actions.act_window'>
        <field name="name">Driving Log</field>
        <field name="res_model">fleet.vehicle.odometer</field>
        <field name="view_mode">tree,graph,pivot,form</field>
        <field name="context">{'search_default_filter_analytic_user_ids': 1, 'search_default_last_3_months': 1}</field>
    </record>
    <record id="fleet_vehicle_odometer_action_mobile_list" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="fleet_vehicle_odometer_action_mobile"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="fleet_vehicle_odometer_view_tree_mobile"/>
    </record>
    <record id="fleet_vehicle_odometer_action_mobile_graph" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="fleet_vehicle_odometer_action_mobile"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="fleet_vehicle_odometer_view_graph_mobile"/>
    </record>
    <record id="fleet_vehicle_odometer_action_mobile_pivot" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="fleet_vehicle_odometer_action_mobile"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="fleet_vehicle_odometer_view_pivot_mobile"/>
    </record>
    <record id="fleet_vehicle_odometer_action_mobile_form" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="fleet_vehicle_odometer_action_mobile"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="fleet_vehicle_odometer_view_form_mobile"/>
    </record>

    <menuitem
        id="menu_fleet_vehicle_odometer_log"
        name="Driving Log"
        parent="fleet.menu_root"
        action="fleet_vehicle_odometer_action_mobile"
        sequence="1"
    />

    <!-- view_mode: added 'pivot' -->
    <record id='fleet.fleet_vehicle_odometer_action' model='ir.actions.act_window'>
        <field name="name">Vehicles Odometer</field>
        <field name="res_model">fleet.vehicle.odometer</field>
        <field name="view_mode">tree,kanban,form,graph,pivot</field>
        <field name="context">{"search_default_groupby_vehicle" : True}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            Create a new odometer log
            </p>
            <p>
            You can add various odometer entries for all vehicles.
            </p>
        </field>
    </record>
</odoo>
