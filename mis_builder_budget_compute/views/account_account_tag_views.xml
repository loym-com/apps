<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_account_tag_view_form" model="ir.ui.view">
        <field name="name">account.account.tag.view.form (in mis_builder_budget_compute)</field>
        <field name="model">account.account.tag</field>
        <field name="inherit_id" ref="account.account_tag_view_form" />
        <field name="arch" type="xml">
            <sheet position="inside">
                <field name="budget_input_ids">
                    <tree editable="bottom">
                        <field name="account_tag_id" invisible="1" />
                        <field name="date_range_id" />
                        <field name="percent" widget="percentage" />
                        <field name="kpi_old" />
                        <field name="kpi_new" />
                    </tree>
                </field>
            </sheet>
        </field>
    </record>
</odoo>
