<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mis_budget_by_account_view_form" model="ir.ui.view">
        <field name="name">mis.budget.by.account.form (in mis_builder_budget_compute)</field>
        <field name="model">mis.budget.by.account</field>
        <field name="inherit_id" ref="mis_builder_budget.mis_budget_by_account_form_view" />
        <field name="arch" type="xml">
            <data>
                <header position="inside">
                    <button
                        name="action_compute_budget_items"
                        string="Compute budget items"
                        type="object"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_show_matrix"
                        string="Show Budget Input Matrix"
                        type="object"
                        attrs="{'invisible': [('date_range_ids', '=', False)]}"
                    />
                </header>
                <field name="date_range_id" position="before">
                    <field name="percent" widget="percentage" />
                    <field name="date_range_ids" widget="many2many_tags" />
                </field>
            </data>
        </field>
    </record>
    <record id="mis_budget_by_account_view_form_budget_input" model="ir.ui.view">
        <field name="name">mis.budget.by.account budget input</field>
        <field name="model">mis.budget.by.account</field>
        <field name="mode">primary</field>
        <field name="type">form</field>
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name" readonly="1" />
                    <p>Percent changes compared with the previous year</p>
                    <field
                        name="budget_input_ids"
                        widget="x2many_2d_matrix"
                        field_x_axis="date_range_id"
                        field_y_axis="account_tag_id"
                        field_value="percent"
                    >
                        <tree default_order="date_range_id,account_tag_id">
                            <field name="date_range_id" />
                            <field name="account_tag_id" />
                            <field name="percent" widget="percentage" />
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
