<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="donation_donation_view_form_reconcile" model="ir.ui.view">
        <field name="name">donation.donation.view.form.reconcile</field>
        <field name="model">donation.donation</field>
        <field name="inherit_id" ref="donation.donation_from_bank_statement_line_form" />
        <field name="arch" type="xml">
            <field name="thanks_template_id" position="after">
                <field
                    name="source_recurring_id"
                    domain="[('partner_id', '=', partner_id), ('recurring_template', '=', 'active')]"
                />
            </field>
        </field>
    </record>
</odoo>
