<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="app_field_view_form" model="ir.ui.view">
        <field name="name">app.field.view.form</field>
        <field name="model">app.field</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="ir_model_id" invisible="1"/>
                        <field
                            name="ir_model_fields_id"
                            domain="[('model_id', '=', ir_model_id)]"
                        />
                        <field
                            name="form_attribute_ids"
                            context="{'default_view_type': 'form'}"
                            attrs="{'invisible': [('ir_model_fields_id', '=', False)]}"
                        >
                            <tree editable="bottom">
                                <!-- <field name="field_id" invisible="0" /> -->
                                <field name="datatype" invisible="1" />
                                <field name="view_type" invisible="1" />
                                <field name="attribute_id" />
                                <field name="value_selection" attrs="{'readonly': [('value_char', '!=', False)]}" />
                                <field name="value_char" attrs="{'readonly': [('value_selection', '!=', False)]}" />
                            </tree>
                        </field>
                        <field
                            name="list_attribute_ids"
                            context="{'default_view_type': 'list'}"
                            attrs="{'invisible': [('ir_model_fields_id', '=', False)]}"
                        >
                            <tree editable="bottom">
                                <!-- <field name="field_id" invisible="0" /> -->
                                <field name="datatype" invisible="1" />
                                <field name="view_type" invisible="1" />
                                <field name="attribute_id" />
                                <field name="value_selection" attrs="{'readonly': [('value_char', '!=', False)]}" />
                                <field name="value_char" attrs="{'readonly': [('value_selection', '!=', False)]}" />
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="app_field_view_tree" model="ir.ui.view">
        <field name="name">app.field.view.tree</field>
        <field name="model">app.field</field>
        <field name="arch" type="xml">
            <tree>
                        <field name="sequence" widget="handle"/>
                        <field name="menuitem_id" optional="show" />
                        <field name="ir_model_fields_id" optional="show" />
                        <field name="form_attribute_ids" optional="show" widget="many2many_tags" />
                        <field name="list_attribute_ids" optional="show" widget="many2many_tags" />
            </tree>
        </field>
    </record>
    <record id="app_field_view_kanban" model="ir.ui.view">
        <field name="name">app.field.view.kanban</field>
        <field name="model">app.field</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <field name="display_name" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="app_field_view_pivot" model="ir.ui.view">
        <field name="name">app.field.view.pivot</field>
        <field name="model">app.field</field>
        <field name="arch" type="xml">
            <pivot>
            </pivot>
        </field>
    </record>
    <record id="app_field_view_search" model="ir.ui.view">
        <field name="name">app.field.view.search</field>
        <field name="model">app.field</field>
        <field name="arch" type="xml">
            <search>
                        <field name="name" />
                        <field name="menuitem_id" />
                        <field name="ir_model_fields_id" />
                <group string="Group By">
                    <filter
                        string="Name"
                        name="name"
                        context="{'group_by':'name'}"
                    />
                    <filter
                        string="Menuitem Id"
                        name="menuitem_id"
                        context="{'group_by':'menuitem_id'}"
                    />
                    <filter
                        string="Ir Model Field Id"
                        name="ir_model_fields_id"
                        context="{'group_by':'ir_model_fields_id'}"
                    />
                    <filter
                        string="Form Attribute Ids"
                        name="form_attribute_ids"
                        context="{'group_by':'form_attribute_ids'}"
                    />
                    <filter
                        string="List Attribute Ids"
                        name="list_attribute_ids"
                        context="{'group_by':'list_attribute_ids'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="app_field_action" model="ir.actions.act_window">
        <field name="name">App Field</field>
        <field name="res_model">app.field</field>
        <field name="view_mode">tree,kanban,pivot,form</field>
    </record>
</odoo>
