<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="app_field_attribute_view_form" model="ir.ui.view">
        <field name="name">app.field.attribute.view.form</field>
        <field name="model">app.field.attribute</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="field_id" />
                        <field name="datatype" readonly="1" />
                        <field name="viewtype" />
                        <field name="attribute_id" />
                        <field name="value_selection" />
                        <field name="value_char" />
                    </group>
                </sheet>
                <!-- <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div> -->
            </form>
        </field>
    </record>
    <record id="app_field_attribute_view_tree" model="ir.ui.view">
        <field name="name">app.field.attribute.view.tree</field>
        <field name="model">app.field.attribute</field>
        <field name="arch" type="xml">
            <tree>
                        <field name="field_id" optional="show" />
                        <field name="viewtype" optional="show" />
                        <field name="attribute_id" optional="show" />
                        <field name="value_selection" optional="show" />
                        <field name="value_char" optional="show" />
            </tree>
        </field>
    </record>
    <record id="app_field_attribute_view_kanban" model="ir.ui.view">
        <field name="name">app.field.attribute.view.kanban</field>
        <field name="model">app.field.attribute</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <field name="display_name" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="app_field_attribute_view_pivot" model="ir.ui.view">
        <field name="name">app.field.attribute.view.pivot</field>
        <field name="model">app.field.attribute</field>
        <field name="arch" type="xml">
            <pivot>
            </pivot>
        </field>
    </record>
    <record id="app_field_attribute_view_search" model="ir.ui.view">
        <field name="name">app.field.attribute.view.search</field>
        <field name="model">app.field.attribute</field>
        <field name="arch" type="xml">
            <search>
                        <field name="field_id" />
                        <field name="viewtype" />
                        <field name="attribute_id" />
                        <field name="value_char" />
                <group string="Group By">
                    <filter
                        string="Viewtype"
                        name="viewtype"
                        context="{'group_by':'viewtype'}"
                    />
                    <filter
                        string="Field Id"
                        name="field_id"
                        context="{'group_by':'field_id'}"
                    />
                    <filter
                        string="Attribute Id"
                        name="attribute_id"
                        context="{'group_by':'attribute_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="app_field_attribute_action" model="ir.actions.act_window">
        <field name="name">App Field Attribute</field>
        <field name="res_model">app.field.attribute</field>
        <field name="view_mode">tree,kanban,pivot,form</field>
    </record>
</odoo>
