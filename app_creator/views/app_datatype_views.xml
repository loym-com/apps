<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="app_datatype_view_form" model="ir.ui.view">
        <field name="name">app.datatype.view.form</field>
        <field name="model">app.datatype</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="xml_attr_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="app_datatype_view_tree" model="ir.ui.view">
        <field name="name">app.datatype.view.tree</field>
        <field name="model">app.datatype</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="code" />
                <field name="xml_attr_ids" widget="many2many_tags" />
            </tree>
        </field>
    </record>
    <record id="app_datatype_action" model="ir.actions.act_window">
        <field name="name">App Datatype</field>
        <field name="res_model">app.datatype</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
