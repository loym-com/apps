<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="app_menuitem_view_form" model="ir.ui.view">
        <field name="name">app.menuitem.view.form</field>
        <field name="model">app.menuitem</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_app"
                            type="object"
                            string="Create/Update App"
                            class="btn-primary"
                            attrs="{'invisible': [('parent_id', '!=', False)]}"/>
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" invisible="1" />
                            <field name="show" />
                            <field name="action_id" attrs="{'invisible': [('show', '!=', 'action')]}"/>
                            <field name="ir_model_id" attrs="{'invisible': [('show', '!=', 'model')]}"/>
                        </group>
                        <group>
                            <field name="root_menu_id" attrs="{'invisible': [('parent_id', '!=', False)]}"/>
                            <field name="parent_id" invisible="1" />
                            <field name="sequence" invisible="1" />
                        </group>
                        <group name="menus" attrs="{'invisible': [('show', '!=', 'menus')]}">
                            <field name="child_ids" nolabel="1" colspan="2">
                                <tree create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" string="Menu"/>
                                    <field name="show" />
                                    <button name="action_open_menuitem" type="object" string="Open" class="btn-primary"/>
                                </tree>
                            </field>
                            <button name="action_add_menuitem" type="object" string="Add a menu" class="btn-primary" colspan="2"/>
                        </group>
                        <group name="views" attrs="{'invisible': ['|', ('show', '!=', 'model'), ('ir_model_id', '=', False)]}">
                            <field name="view_ids" nolabel="1" colspan="2">
                                <tree create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_name" string="Views"/>
                                    <field name="id" invisible="1"/>
                                    <button name="action_open_view" type="object" string="Open" class="btn-primary" context="{'view_id': id}"/>
                                </tree>
                            </field>
                            <button name="action_add_view" type="object" string="Add a view" class="btn-primary" colspan="2"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="app_menuitem_view_tree" model="ir.ui.view">
        <field name="name">app.menuitem.view.tree</field>
        <field name="model">app.menuitem</field>
        <field name="arch" type="xml">
            <tree>
                        <field name="sequence" widget="handle"/>
                        <field name="display_name"/>
            </tree>
        </field>
    </record>
