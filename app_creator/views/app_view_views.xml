<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="app_view_view_form" model="ir.ui.view">
        <field name="name">app.view.view.form</field>
        <field name="model">app.view</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="menuitem_id" invisible="1"/>
                        <field name="view_type" />
                    </group>
                    <group>
                        <group name="attrs" string="Attributes" attrs="{'invisible': [('view_type', '=', False)]}">
                            <field name="attr_ids" nolabel="1" colspan="2">
                                <tree editable="bottom">
                                    <field name="xml_attr_domain_ids" invisible="1"/>
                                    <field name="xml_attr_id" domain="[('id', 'in', xml_attr_domain_ids)]"/>
                                    <field name="value_option" attrs="{'readonly': [('value_char', '!=', False)]}" />
                                    <field name="value_char" attrs="{'readonly': [('value_option', '!=', False)]}" />
                                </tree>
                            </field>
                            <field name="attr_char"/>
                        </group>
                        <group name="viewitem_ids" string="Fields/Tags" attrs="{'invisible': [('view_type', '=', False)]}">
                            <field name="viewitem_ids" nolabel="1" colspan="2" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
