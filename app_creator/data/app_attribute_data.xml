<odoo>
    <record id="attr_char_widget" model="app.attribute">
        <field name="name">Widget</field>
        <field name="code">widget</field>
        <field name="datatype_ids" eval="[(4, ref('app_creator.app_datatype_char'))]"/>
    </record>
    <record id="attr_char_widget_email" model="app.attribute.selection">
        <field name="name">Email</field>
        <field name="code">email</field>
        <field name="attribute_id" ref="attr_char_widget"/>
    </record>

    <record id="attr_many2many_widget" model="app.attribute">
        <field name="name">Widget</field>
        <field name="code">widget</field>
        <field name="datatype_ids" eval="[(4, ref('app_creator.app_datatype_many2many'))]"/>
    </record>
    <record id="attr_many2many_widget_tags" model="app.attribute.selection">
        <field name="name">Tags</field>
        <field name="code">many2many_tags</field>
        <field name="attribute_id" ref="attr_many2many_widget"/>
    </record>

    <record id="attr_many2one_widget" model="app.attribute">
        <field name="name">Widget</field>
        <field name="code">widget</field>
        <field name="datatype_ids" eval="[(4, ref('app_creator.app_datatype_many2one'))]"/>
    </record>
    <record id="attr_many2one_widget_tags" model="app.attribute.selection">
        <field name="name">Tags</field>
        <field name="code">many2many_tags</field>
        <field name="attribute_id" ref="attr_many2one_widget"/>
    </record>
</odoo>
