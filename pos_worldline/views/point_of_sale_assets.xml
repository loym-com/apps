<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assets" inherit_id="point_of_sale.assets">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/pos_worldline/static/src/js/models.js"></script>
            <script type="text/javascript" src="/pos_worldline/static/src/js/payment_worldline.js"></script>
        </xpath>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template inherit_id="point_of_sale.assets_common" name="POS Assets Common">
    <t t-call-assets="point_of_sale.pos_assets_backend_style" t-js="false"/>
    <t t-call-assets="point_of_sale.assets" t-js="false" />
    <t t-call-assets="web.assets_common" t-css="false" />
    <t t-call-assets="point_of_sale.pos_assets_backend" t-css="false" />
    <t t-call-assets="point_of_sale.assets" t-css="false" />
</template>

</odoo>
