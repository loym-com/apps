<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <!-- event.event -->

        <record model="ir.ui.view" id="view_event_form_require_email_phone">
            <field name="name">Require email or phone</field>
            <field name="model">event.event</field>
            <field name="inherit_id" ref="event.view_event_form" />
            <field name="priority" eval="20" />
            <field name="arch" type="xml">
                <data>
                    <field name="auto_confirm" position="after">
                        <field name="require_email" />
                        <field name="require_phone" />
                    </field>
                </data>
            </field>
        </record>

        <!-- qweb -->

        <template
            id="registration_attendee_details"
            inherit_id="website_event.registration_attendee_details"
        >
            <data>
                <xpath expr="//div[hasclass('row')]" position="replace">
                    <div class="row">
                        <div class="col-lg my-2">
                            <label>Name *</label>
                            <input
                                class="form-control"
                                type="text"
                                t-attf-name="#{counter}-name"
                                t-att-value="default_first_attendee.get('name', '') if counter == 1 else ''"
                                required="This field is required"
                            />
                        </div>
                        <div class="col-lg my-2">
                            <label>Email
                                <small t-if="event.require_email">*</small>
                                <small t-else="">(Optional)</small>
                            </label>
                            <input
                                t-if="event.require_email"
                                class="form-control"
                                type="email"
                                t-attf-name="#{counter}-email"
                                t-att-value="default_first_attendee.get('email', '') if counter == 1 else ''"
                                required="This field is required"
                            />
                            <input
                                t-else=""
                                class="form-control"
                                type="email"
                                t-attf-name="#{counter}-email"
                                t-att-value="default_first_attendee.get('email', '') if counter == 1 else ''"
                            />
                        </div>
                        <div class="col-lg my-2">
                            <label>Phone
                                <small t-if="event.require_phone">*</small>
                                <small t-else="">(Optional)</small>
                            </label>
                            <input
                                t-if="event.require_phone"
                                class="form-control"
                                type="tel"
                                t-attf-name="#{counter}-phone"
                                t-att-value="default_first_attendee.get('phone', '') if counter == 1 else ''"
                                required="This field is required"
                            />
                            <input
                                t-else=""
                                class="form-control"
                                type="tel"
                                t-attf-name="#{counter}-phone"
                                t-att-value="default_first_attendee.get('phone', '') if counter == 1 else ''"
                            />
                        </div>
                        <input
                            class="d-none"
                            type="text"
                            t-attf-name="#{counter}-event_ticket_id"
                            t-attf-value="#{ticket['id']}"
                        />
                    </div>
                </xpath>

            </data>
        </template>

    </data>
</odoo>
