<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.is_valid_postal_address</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="vat" position="before">
                <field name="is_valid_postal_address" />
            </field>
        </field>
    </record>
    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.view.search.is_valid_postal_address</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <search position="inside">
                <filter string="Valid Address" name="valid_address" domain="[('is_valid_postal_address', '=', True)]"/>
                <filter string="Invalid Address" name="invalid_address" domain="[('is_valid_postal_address', '=', False)]"/>
            </search>
        </field>
    </record>
</odoo>
