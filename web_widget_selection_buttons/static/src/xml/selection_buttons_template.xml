<templates id="template" xml:space="preserve">
    <t t-name="web_widget_selection_buttons.SelectionButtons" owl="1">
        <div class="btn-group">
            <t t-foreach="widget.field.selection" t-as="option">
                <button type="button"
                        t-att-class="btn btn-sm #{widget.state.value === option[0] ? 'btn-primary' : 'btn-outline-secondary'}"
                        t-on-click.prevent="widget._onClick(option)">
                    <t t-esc="option[1]"/>
                </button>
            </t>
        </div>
    </t>
</templates>