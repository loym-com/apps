<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.view.form.event.registration</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//tree//field[@name='product_template_id']" position="after">
                <field name="resource_booking_ids" optional="hide" widget="many2many_tags" groups="base.group_no_one"/>
                <field name="event_registration_id" optional="hide" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>
