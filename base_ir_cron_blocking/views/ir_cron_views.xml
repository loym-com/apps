<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_view_form" model="ir.ui.view">
        <field name="model">ir.cron</field>
        <field name="name">ir.cron.view.form.inherit.blocking</field>
        <field name="inherit_id" ref="base.ir_cron_view_form"/>
        <field name="arch" type="xml">
            <data>
                <div class="oe_title" position="before">
                    <widget name="web_ribbon" title="Blocked" bg_color="bg-danger" attrs="{'invisible': [('blocked', '=', False)]}"/>
                </div>
                <xpath expr="//group[@name='action_content']" position="inside">
                    <field name="blocked" widget="boolean_toggle"/>
                    <field name="note"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
