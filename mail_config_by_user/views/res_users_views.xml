<odoo>
    <record id="res_users_view_form_inherit" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <button
                    name="action_mail_config_by_user"
                    type="object"
                    string="Configure Outgoing Email"
                    colspan="2"
                />
            </field>
        </field>
    </record>
    <record id="res_users_view_list" model="ir.ui.view">
        <field name="name">res.users.view.list.inherit</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <tree position="inside">
                <field name="mail_server_id" optional="hide" />
            </tree>
        </field>
    </record>
</odoo>
