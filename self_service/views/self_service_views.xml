<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="self_service_view_form" model="ir.ui.view">
        <field name="name">self.service.view.form</field>
        <field name="model">self.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id" widget="selection_badge"/>
                        <field name="product_description_sale" readonly="1"/>
                        <field name="product_uom_id" readonly="1"/>
                        <field name="product_list_price" readonly="1"/>
                        <field name="quantity" />
                        <field name="total" readonly="1"/>
                        <field name="user_id" />
                        <field name="date" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="self_service_view_list" model="ir.ui.view">
        <field name="name">self.service.view.list</field>
        <field name="model">self.service</field>
        <field name="arch" type="xml">
            <tree>
                        <field name="product_id" optional="show" />
                        <field name="product_description_sale" optional="show" />
                        <field name="product_uom_id" optional="show" />
                        <field name="product_list_price" optional="show" />
                        <field name="quantity" optional="show" />
                        <field name="total" optional="show" />
                        <field name="user_id" optional="show" />
                        <field name="date" optional="show" />
            </tree>
        </field>
    </record>
    <record id="self_service_view_kanban" model="ir.ui.view">
        <field name="name">self.service.view.kanban</field>
        <field name="model">self.service</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <field name="display_name" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="self_service_view_pivot" model="ir.ui.view">
        <field name="name">self.service.view.pivot</field>
        <field name="model">self.service</field>
        <field name="arch" type="xml">
            <pivot>
            </pivot>
        </field>
    </record>
    <record id="self_service_view_search" model="ir.ui.view">
        <field name="name">self.service.view.search</field>
        <field name="model">self.service</field>
        <field name="arch" type="xml">
            <search>
                        <field name="product_id" />
                        <field name="product_description_sale" />
                        <field name="product_uom_id" />
                        <field name="product_list_price" />
                        <field name="quantity" />
                        <field name="total" />
                        <field name="user_id" />
                        <field name="date" />
                <group string="Group By">
                    <filter
                        string="Display Name"
                        name="display_name"
                        context="{'group_by':'display_name'}"
                    />
                    <filter
                        string="Product Id"
                        name="product_id"
                        context="{'group_by':'product_id'}"
                    />
                    <filter
                        string="Product Description Sale"
                        name="product_description_sale"
                        context="{'group_by':'product_description_sale'}"
                    />
                    <filter
                        string="Product Uom Id"
                        name="product_uom_id"
                        context="{'group_by':'product_uom_id'}"
                    />
                    <filter
                        string="Product List Price"
                        name="product_list_price"
                        context="{'group_by':'product_list_price'}"
                    />
                    <filter
                        string="Quantity"
                        name="quantity"
                        context="{'group_by':'quantity'}"
                    />
                    <filter
                        string="Total"
                        name="total"
                        context="{'group_by':'total'}"
                    />
                    <filter
                        string="User Id"
                        name="user_id"
                        context="{'group_by':'user_id'}"
                    />
                    <filter
                        string="Date"
                        name="date"
                        context="{'group_by':'date'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="self_service_action" model="ir.actions.act_window">
        <field name="name">Self Service</field>
        <field name="res_model">self.service</field>
        <field name="view_mode">list,kanban,pivot,form</field>
    </record>
</odoo>
