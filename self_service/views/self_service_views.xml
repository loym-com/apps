<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="self_service_view_form" model="ir.ui.view">
        <field name="name">self.service.view.form</field>
        <field name="model">self.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <group attrs="{'invisible': [('product_id', '=', False)]}">
                                <h1 colspan="2">
                                    <field name="product_id" attrs="{'invisible': [('product_id', '=', False)]}"/>
                                </h1>
                                <field name="product_description_sale" readonly="1" nolabel="1" colspan="2"/>
                                <field name="product_self_service_step" invisible="1"/>
                                <div>
                                    <field name="product_uom_id" readonly="1"/>
                                </div>
                                <div class="o_row" attrs="{'invisible': [('product_self_service_step', '!=', '0.1')]}">
                                    <field name="quantity" widget="numeric_step" options="{'step': 0.1}"/>
                                </div>
                                <div class="o_row" attrs="{'invisible': [('product_self_service_step', '!=', '1')]}">
                                    <field name="quantity" widget="numeric_step" options="{'step': 1}"/>
                                </div>
                                <div class="o_row" attrs="{'invisible': [('product_self_service_step', '!=', '10')]}">
                                    <field name="quantity" widget="numeric_step" options="{'step': 10}"/>
                                </div>
                                <div class="o_row" attrs="{'invisible': [('product_self_service_step', '!=', '100')]}">
                                    <field name="quantity" widget="numeric_step" options="{'step': 100}"/>
                                </div>
                                <div class="o_row" attrs="{'invisible': [('product_self_service_step', '!=', '1000')]}">
                                    <field name="quantity" widget="numeric_step" options="{'step': 1000}"/>
                                </div>
                                <field name="product_variant_price" readonly="1"/>
                                <field name="cost" readonly="1"/>
                                <field name="user_id" readonly="0"/>
                                <!-- <field name="user_id" invisible="1"/> -->
                                <field name="date" readonly="0"/>
                                <!-- <field name="date" invisible="1"/> -->
                            </group>
                            <!-- The product_id SELECTION must come after the product_id HEADING. -->
                            <field name="product_id" widget="selection_badge" attrs="{'invisible': [('product_id', '!=', False)]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="self_service_view_list" model="ir.ui.view">
        <field name="name">self.service.view.list</field>
        <field name="model">self.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_id" />
                <field name="date" />
                <field name="quantity" />
                <field name="product_uom_id" optional="hide" />
                <field name="product_variant_price" optional="hide" />
                <field name="cost" />
                <field name="user_id" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="self_service_view_graph" model="ir.ui.view">
        <field name="name">self.service.view.graph</field>
        <field name="model">self.service</field>
        <field name="arch" type="xml">
            <graph>
                <field name="date"/>
                <field name="cost" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="self_service_view_pivot" model="ir.ui.view">
        <field name="name">self.service.view.pivot</field>
        <field name="model">self.service</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="product_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="quantity" type="measure"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="self_service_view_search" model="ir.ui.view">
        <field name="name">self.service.view.search</field>
        <field name="model">self.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" />
                <field name="user_id" />
                <filter name="date" string="Date" date="date"/>
                <separator/>
                <filter
                    name="filter_user_id"
                    string="My Records"
                    domain="[('user_id', '=', uid)]"
                    help="Show only records assigned to me"
                />
                <separator/>
                <filter
                    name="last_3_months"
                    string="Last 3 Months"
                    domain="[('date', '>=', (datetime.date(context_today().year, context_today().month, 1) - relativedelta(months=2)).strftime('%Y-%m-%d'))]"
                />
                <group string="Group By">
                    <filter
                        string="Product"
                        name="group_by_product_id"
                        context="{'group_by':'product_id'}"
                    />
                    <filter
                        string="User"
                        name="group_by_user_id"
                        context="{'group_by':'user_id'}"
                    />
                    <filter
                        string="Date"
                        name="group_by_date"
                        context="{'group_by':'date'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="self_service_action" model="ir.actions.act_window">
        <field name="name">Self Service</field>
        <field name="res_model">self.service</field>
        <field name="view_mode">tree,graph,pivot,form</field>
        <field name="context">{'search_default_filter_user_id': 1, 'search_default_last_3_months': 1}</field>
    </record>
</odoo>
