<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <!-- DONATION.THANKS-->

    <record id="mail_template_donation_thanks" model="mail.template">
        <field name="name">Donation Thanks</field>
        <field name="model_id" ref="donation_thanks.model_donation_thanks" />
        <field name="partner_to">{{object.partner_id.id}}</field>
        <field name="reply_to">{{user.login}}</field>
        <field name="lang">{{object.partner_id.lang}}</field>
        <field name="auto_delete" eval="0" />
        <field name="subject">Thank you!</field>
        <field
            name="body_html"
        ><![CDATA[
<div>
    <p>Dear <span t-out="object.partner_id.name"/>,</p>
    <p>Thank you for supporting the work of the <span t-out="object.env.company.name"/>!</p>
    <p>Please find attached the latest newsletter. I hope you will enjoy it.</p>

    <t t-if="object.env.ref('donation_thanks.res_partner_category_newsletter') not in object.category_id.parent_id">
        <p>
            We would like to continue sending you updates.
            <b>Reply to this email</b> if you wish to continue receiving this newsletter.
        </p>
    </t>

    <p>Best regards,</p>
</div>
<div>
    <span t-out="user.signature"/>
</div>]]></field>
        <field
            name="report_template"
            ref="action_report_donation_thanks"
        />
        <field name="report_name">Thanks to {{object.partner_id.name}}.pdf</field>
    </record>

    <!-- DONATION.TAX.RECEIPT -->

    <record id="mail_template_donation_tax_receipt" model="mail.template">
        <field name="name">Donation Tax Receipt Thanks</field>
        <field name="model_id" ref="donation_base.model_donation_tax_receipt" />
        <field name="partner_to">{{object.partner_id.id}}</field>
        <field name="reply_to">{{user.login}}</field>
        <field name="lang">{{object.partner_id.lang}}</field>
        <field name="auto_delete" eval="0" />
        <field name="subject">Donation Tax Receipt from the Granheim Foundation</field>
        <field
            name="body_html"
        ><![CDATA[
<div>
    <p>Dear <span t-out="object.partner_id.name"/>,</p>
    <p>Thank you for supporting the work of the Granheim Foundation!</p>
    <p>Please find attached your tax report for last year.</p>

    <p>Best regards,</p>
</div>
<div>
    <span t-out="user.signature"/>
</div>]]></field>
        <field
            name="report_template"
            ref="action_report_donation_tax_receipt"
        />
    </record>
</odoo>
