<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1"><!-- or set py3o_filetype=pdf and external dependency libreoffice -->
    <record id="action_report_address_sheet_a4" model="ir.actions.report">
        <field name="name">Address on A4 sheet</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">donation_thanks.report_address_sheet_a4</field>
        <field name="report_file">donation_thanks.report_address_sheet_a4</field>
        <field name="paperformat_id" ref="base.paperformat_euro" />
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="base.model_res_partner" />
    </record>
    <record id="action_report_address_envelope_dle" model="ir.actions.report">
        <field name="name">Envelope DLE (110x220 mm)</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">donation_thanks.report_address_envelope_dle</field>
        <field name="report_file">donation_thanks.report_address_envelope_dle</field>
        <field name="paperformat_id" ref="paperformat_dle" />
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="base.model_res_partner" />
    </record>
    <record id="action_report_address_envelope_c5" model="ir.actions.report">
        <field name="name">Envelope C5</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">donation_thanks.report_address_envelope_c5</field>
        <field name="report_file">donation_thanks.report_address_envelope_c5</field>
        <field name="paperformat_id" ref="paperformat_c5" />
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="base.model_res_partner" />
    </record>
    <record id="action_report_donation_thanks" model="ir.actions.report">
        <field name="name">Donation thanks</field>
        <field name="model">donation.thanks</field>
        <field name="report_type">py3o</field>
        <field name="py3o_filetype">odt</field>
        <field name="module">donation_thanks</field>
        <field name="py3o_template_fallback">reports/report_donation_thanks.odt</field>
        <field name="report_name">mandatory field in database (donation.thanks)</field>
        <field name="print_report_name">f"Thank you, {object.partner_id.name}"</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="donation_thanks.model_donation_thanks" />
    </record>
    <record id="action_report_donation_tax_receipt" model="ir.actions.report">
        <field name="name">Donation tax receipt thanks</field>
        <field name="model">donation.tax.receipt</field>
        <field name="report_type">py3o</field>
        <field name="py3o_filetype">odt</field>
        <field name="module">donation_thanks</field>
        <field name="py3o_template_fallback">reports/report_donation_tax_receipt.odt</field>
        <field name="report_name">mandatory field in database (donation.tax.receipt)</field>
        <field name="print_report_name">f"Tax receipt for donations - {object.partner_id.name}"</field>
        <field name="binding_type">report</field>
        <field name="binding_model_id" ref="donation_base.model_donation_tax_receipt" />
    </record>
</odoo>
