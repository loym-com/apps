<odoo>
    <!-- Form View -->
    <record id="donation_thanks_view_form" model="ir.ui.view">
        <field name="name">donation.thanks.form</field>
        <field name="model">donation.thanks</field>
        <field name="arch" type="xml">
            <form string="Donation Thanks">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="thanks_template_id"/>
                        <field name="print_date"/>
                    </group>
                    <group>
                        <field name="donation_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="donation_thanks_view_tree" model="ir.ui.view">
        <field name="name">donation.thanks.tree</field>
        <field name="model">donation.thanks</field>
        <field name="arch" type="xml">
            <tree string="Donation Thanks">
                <field name="partner_id"/>
                <field name="thanks_template_id"/>
                <field name="print_date"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="donation_thanks_view_search" model="ir.ui.view">
        <field name="name">donation.thanks.search</field>
        <field name="model">donation.thanks</field>
        <field name="arch" type="xml">
            <search string="Donation Thanks">
                <field name="partner_id"/>
                <field name="thanks_template_id"/>
                <field name="print_date"/>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="donation_thanks_action" model="ir.actions.act_window">
        <field name="name">Donation Thanks</field>
        <field name="res_model">donation.thanks</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_create">
                Go to donations list, select records, click Actions and select "Create Thanks".
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_donation_thanks"
        name="Donation Thanks"
        parent="donation.donation_title_menu"
        action="donation_thanks_action"
        sequence="30"
    />
</odoo>