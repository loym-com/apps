<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="donation_tax_receipt_view_form" model="ir.ui.view">
        <field name="name">donation.donation.tax.receipt.view.form</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_form" />
        <field name="arch" type="xml">
            <group name="main" position="inside">
                <field name="thanks_template_id" />
            </group>
        </field>
    </record>
    <record id="donation_tax_receipt_view_tree" model="ir.ui.view">
        <field name="name">donation.tax.receipt.view.tree</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_tree" />
        <field name="arch" type="xml">
            <tree position="inside">
                <field name="thanks_template_id" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="donation_tax_receipt_view_search" model="ir.ui.view">
        <field name="name">donation.tax.receipt.view.search</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_search" />
        <field name="arch" type="xml">
            <search position="inside">
                <field name="thanks_template_id" />
            </search>
        </field>
    </record>
</odoo>
