<odoo>
    <record id="hr_leave_type_view_form" model="ir.ui.view">
        <field name="name">hr.leave.type.form Norway</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group name="norway" string="Norway">
                    <field name="l10n_no_type" />
                    <field name="l10n_no_PermisjonsOgPermitteringsBeskrivelse" attrs="{'invisible': [('l10n_no_type', '!=', 'permisjon')]}" />
                    <field name="l10n_no_PermisjonLoennetUloennet" attrs="{'invisible': [('l10n_no_type', '!=', 'permisjon')]}" />
                    <field name="l10n_no_Permitteringsaarsak" attrs="{'invisible': [('l10n_no_type', '!=', 'permittering')]}" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
