<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_payslip_run_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.run Norway</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="payroll.hr_payslip_run_view_form" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <data>
                <label for="date_start" position="before">
                    <field name="l10n_no_Loennsutbetalingsdato" />
                </label>
                <sheet position="inside">
                    <group name="norway" string="Norway">
                        <field name="l10n_no_AgapliktUtenLoennsopplysningsplikt" groups="base.group_no_one" />
                    </group>
                </sheet>
            </data>

        </field>
    </record>
</odoo>
