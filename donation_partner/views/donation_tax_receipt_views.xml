<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="donation_tax_receipt_view_form" model="ir.ui.view">
        <field name="name">donation.tax.receipt.view.form</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_valid_postal_address" />
                <field name="partner_email" />
                <field name="partner_lang" />
                <field name="partner_tag_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>

    <record id="donation_tax_receipt_view_tree" model="ir.ui.view">
        <field name="name">donation.tax.receipt.view.tree</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_valid_postal_address" optional="hide" />
                <field name="partner_email" optional="hide" />
                <field name="partner_lang" optional="hide" />
                <field name="partner_tag_ids" widget="many2many_tags" optional="hide" />
            </field>
        </field>
    </record>

    <record id="donation_tax_receipt_view_search" model="ir.ui.view">
        <field name="name">donation.tax.receipt.view.search</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_search" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_lang" />
                <field name="partner_tag_ids"/>
            </field>
        </field>
    </record>
</odoo>
