<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="donation_donation_view_form" model="ir.ui.view">
        <field name="name">donation.donation.view.form</field>
        <field name="model">donation.donation</field>
        <field name="inherit_id" ref="donation.donation_form" />
        <field name="arch" type="xml">
            <group name="other-right" position="inside">
                <field name="partner_valid_postal_address" />
                <field name="partner_email" />
                <field name="partner_lang" />
                <field name="partner_tag_ids" widget="many2many_tags" />
            </group>
        </field>
    </record>

    <record id="donation_donation_view_tree" model="ir.ui.view">
        <field name="name">donation.donation.view.tree</field>
        <field name="model">donation.donation</field>
        <field name="inherit_id" ref="donation.donation_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_valid_postal_address" optional="hide" />
                <field name="partner_email" optional="hide" />
                <field name="partner_lang" optional="hide" />
                <field name="partner_tag_ids" widget="many2many_tags" optional="hide" />
            </field>
        </field>
    </record>

    <record id="donation_donation_view_search" model="ir.ui.view">
        <field name="name">donation.donation.view.search</field>
        <field name="model">donation.donation</field>
        <field name="inherit_id" ref="donation.donation_search" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_lang" />
                <field name="partner_tag_ids" />
            </field>
        </field>
    </record>
</odoo>
