<odoo>
    <record id="code_list_usage_view_tree" model="ir.ui.view">
        <field name="model">code.list.usage</field>
        <field name="arch" type="xml">
            <tree editable="bottom" >
                <field name="model"/>
                <field name="resource_id" />
                <field name="code_list_id" />
                <field name="code_list_item_id" />
                <field name="note" optional="hide" />
            </tree>
        </field>
    </record>
    <record id="code_list_usage_view_search" model="ir.ui.view">
        <field name="model">code.list.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="model"/>
                <field name="resource_id" />
                <field name="code_list_id" />
                <field name="code_list_item_id" />
                <field name="note" />
            </search>
        </field>
    </record>
    <record id="code_list_usage_action" model="ir.actions.act_window">
        <field name="name">Code List Usages</field>
        <field name="res_model">code.list.usage</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem
        id="code_list_usage_menu"
        action="code_list_usage_action"
        parent="base.menu_ir_property"
        sequence="150"
    />
</odoo>
